{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Brick: Upload main.py",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/pybricksdev",
            "args": [
                "run",
                "ble",
                "${workspaceFolder}/brick/main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Desktop: App starten",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "args": [
                "main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}/desktop"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Desktop: App starten (Hub-Name angeben)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "args": [
                "main.py",
                "--hub-name",
                "${input:hubName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}/desktop"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Brick: Compile Check",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3",
            "args": [
                "-m",
                "py_compile",
                "${workspaceFolder}/brick/main.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$python"
        }
    ],
    "inputs": [
        {
            "id": "hubName",
            "type": "promptString",
            "description": "Name des Pybricks Hubs (Bluetooth)",
            "default": "Pybricks Hub"
        }
    ]
}
